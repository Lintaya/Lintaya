# Required
BW_DOMAIN=bitwarden.example.com
BW_INSTALLATION_ID=replace-me
BW_INSTALLATION_KEY=replace-me

# Simplest database option for a personal install
BW_DB_PROVIDER=sqlite

# Optional: leave false if you will put Bitwarden behind Caddy, Nginx, or another HTTPS reverse proxy.
# If you want Bitwarden itself to terminate TLS, change this to true and provide cert files in /etc/bitwarden.
BW_ENABLE_SSL=false

# Optional mail settings
# globalSettings__mail__replyToEmail=admin@example.com
# globalSettings__mail__smtp__host=smtp.example.com
# globalSettings__mail__smtp__port=587
# globalSettings__mail__smtp__ssl=false
# globalSettings__mail__smtp__username=smtp-user
# globalSettings__mail__smtp__password=smtp-password
