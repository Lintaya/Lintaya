{
  "manifestVersion": 1,
  "id": "bitbucket",
  "displayName": "Bitbucket",
  "version": "0.2.0",
  "tier": "community",
  "lifecycle": "beta",
  "license": "Apache-2.0",
  "capabilities": ["repositories.read", "repositories.clone", "pull-requests.read", "commits.read"],
  "implementation": { "mode": "package", "source": "server/connectors/community/bitbucket/index.js" },
  "instantiable": true,
  "modules": [
    { "id": "repositories", "label": "Repos {connectorName}", "icon": "repos", "component": "ReposView", "navOrder": 92 }
  ]
}
