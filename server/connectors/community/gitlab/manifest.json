{
  "manifestVersion": 1,
  "id": "gitlab",
  "displayName": "GitLab",
  "version": "0.3.0",
  "tier": "community",
  "lifecycle": "beta",
  "license": "Apache-2.0",
  "capabilities": ["repositories.read", "repositories.clone", "pull-requests.read", "deployments.read", "workflows.read", "issues.read", "commits.read"],
  "implementation": { "mode": "package", "source": "server/connectors/community/gitlab/index.js" },
  "instantiable": true,
  "blocks": [
    { "id": "recent-commits", "title": "GitLab \u2014 \u00faltimos commits", "icon": "\ud83d\udd27", "type": "list" },
    { "id": "recent-deployments", "title": "GitLab \u2014 deployments recientes", "icon": "\ud83d\ude80", "type": "list" },
    { "id": "open-pull-requests", "title": "GitLab \u2014 pull requests abiertos", "icon": "\ud83d\udd04", "type": "list" },
    { "id": "open-issues", "title": "GitLab \u2014 issues abiertos", "icon": "\ud83d\udc1e", "type": "list" },
    { "id": "repos-overview", "title": "GitLab \u2014 mis repos", "icon": "\ud83d\udce6", "type": "list" }
  ],
  "modules": [{ "id": "repositories", "label": "Repos {connectorName}", "icon": "repos", "component": "ReposView", "navOrder": 90 }]
}
