{
  "name": "lintaya-server",
  "version": "0.1.0-beta.1",
  "description": "Servidor de Lintaya para administrar y analizar proyectos Git",
  "private": true,
  "license": "Apache-2.0",
  "main": "server.js",
  "bin": {
    "lintaya-mcp": "mcp-server.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node -e \"process.env.LINTAYA_TOKEN='dev-token';process.env.VAULT_MASTER_PASSWORD='dev-master';process.env.PORT='3000';require('./server.js').startServer()\"",
    "test": "npm run test:analysis && npm run test:http && npm run test:core && npm run test:routes && npm run test:connectors",
    "test:analysis": "node analysis/analysis.test.js",
    "test:http": "node --test app.test.js",
    "test:routes": "node --test \"routes/*.test.js\"",
    "test:core": "node --test \"core/**/*.test.js\"",
    "test:connectors": "node --test \"connectors/**/*.test.js\"",
    "check:syntax": "node ../scripts/check-js-syntax.mjs",
    "check": "npm run check:syntax && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@bitwarden/cli": "^2026.4.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "ssh2": "^1.17.0",
    "ws": "^8.20.1"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "overrides": {
    "multer": "2.3.0",
    "qs": "6.16.0",
    "tmp": "0.2.7"
  }
}
